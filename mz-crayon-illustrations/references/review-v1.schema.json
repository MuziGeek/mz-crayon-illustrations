{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "creator.muzi-crayon-review/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "judgment",
    "metaphor",
    "muziAction",
    "lockedLabels",
    "textRevisionRounds",
    "outputPath"
  ],
  "properties": {
    "schema": { "const": "creator.muzi-crayon-review/1" },
    "status": { "const": "READY_FOR_REVIEW" },
    "judgment": { "type": "string", "minLength": 1 },
    "metaphor": { "type": "string", "minLength": 1 },
    "muziAction": {
      "enum": [
        "collect", "read", "inspect", "compare",
        "sort", "connect", "decide", "stop-check",
        "build", "write", "test", "repair",
        "explain", "retrieve", "share", "deliver"
      ]
    },
    "lockedLabels": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "textRevisionRounds": { "type": "integer", "minimum": 0, "maximum": 2 },
    "outputPath": { "type": "string", "pattern": "\\.png$" }
  }
}
