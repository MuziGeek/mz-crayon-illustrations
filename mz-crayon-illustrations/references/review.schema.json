{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "creator.mz-crayon-review/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "judgment", "structure", "density", "metaphor", "objects", "storyFlow", "characterMode", "characterProfile", "lockedLabels", "regenerationRounds", "textRevisionRounds", "outputPath"],
  "properties": {
    "schema": {"const": "creator.mz-crayon-review/1"},
    "status": {"const": "READY_FOR_REVIEW"},
    "judgment": {"type": "string", "minLength": 1},
    "structure": {"enum": ["single-point", "comparison", "sequence", "state", "environment", "focus"]},
    "density": {"enum": ["minimal", "narrative"]},
    "metaphor": {"type": "string", "minLength": 1},
    "objects": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "object", "additionalProperties": false, "required": ["name", "role"], "properties": {"name": {"type": "string", "minLength": 1}, "role": {"enum": ["problem", "action", "result", "state"]}}}},
    "storyFlow": {"type": "string", "minLength": 1},
    "characterMode": {"enum": ["none", "external"]},
    "characterProfile": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["id", "version", "extensionId", "manifestHash"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "extensionId": {"type": "string", "minLength": 1}, "manifestHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}]},
    "lockedLabels": {"type": "array", "minItems": 3, "maxItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "regenerationRounds": {"type": "integer", "minimum": 0, "maximum": 2},
    "textRevisionRounds": {"type": "integer", "minimum": 0, "maximum": 2},
    "outputPath": {"type": "string", "pattern": "\\.png$"}
  }
}
