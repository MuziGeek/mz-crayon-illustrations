{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "creator.muzi-crayon-review/2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "judgment",
    "structure",
    "composition",
    "density",
    "metaphor",
    "objects",
    "storyFlow",
    "actionMode",
    "actionReference",
    "muziAction",
    "lockedLabels",
    "identityChecks",
    "regenerationRounds",
    "textRevisionRounds",
    "outputPath"
  ],
  "properties": {
    "schema": { "const": "creator.muzi-crayon-review/2" },
    "status": { "const": "READY_FOR_REVIEW" },
    "judgment": { "type": "string", "minLength": 1 },
    "structure": {
      "enum": ["single-point", "comparison", "sequence", "state", "environment", "focus"]
    },
    "composition": {
      "enum": [
        "centered", "side-by-side", "character-action", "object-closeup",
        "environment-metaphor", "mini-metaphor", "sequence",
        "information-focus", "emotion-closeup"
      ]
    },
    "density": { "enum": ["minimal", "narrative"] },
    "metaphor": { "type": "string", "minLength": 1 },
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "role": { "enum": ["problem", "action", "result", "state"] }
        }
      }
    },
    "storyFlow": { "type": "string", "minLength": 1 },
    "actionMode": { "enum": ["library", "free"] },
    "actionReference": {
      "oneOf": [
        {
          "enum": [
            "collect", "read", "inspect", "compare",
            "sort", "connect", "decide", "stop-check",
            "build", "write", "test", "repair",
            "explain", "retrieve", "share", "deliver"
          ]
        },
        { "type": "null" }
      ]
    },
    "muziAction": { "type": "string", "minLength": 1 },
    "lockedLabels": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "identityChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "faceAndHair",
        "sunglasses",
        "outfitAndProportion",
        "crayonStyle",
        "activeParticipation"
      ],
      "properties": {
        "faceAndHair": { "const": true },
        "sunglasses": { "const": true },
        "outfitAndProportion": { "const": true },
        "crayonStyle": { "const": true },
        "activeParticipation": { "const": true }
      }
    },
    "regenerationRounds": { "type": "integer", "minimum": 0, "maximum": 2 },
    "textRevisionRounds": { "type": "integer", "minimum": 0, "maximum": 2 },
    "outputPath": { "type": "string", "pattern": "\\.png$" }
  },
  "allOf": [
    {
      "if": { "properties": { "density": { "const": "minimal" } } },
      "then": { "properties": { "objects": { "maxItems": 3 } } }
    },
    {
      "if": { "properties": { "density": { "const": "narrative" } } },
      "then": { "properties": { "objects": { "minItems": 3, "maxItems": 6 } } }
    },
    {
      "if": { "properties": { "actionMode": { "const": "library" } } },
      "then": { "properties": { "actionReference": { "type": "string" } } }
    },
    {
      "if": { "properties": { "actionMode": { "const": "free" } } },
      "then": { "properties": { "actionReference": { "type": "null" } } }
    }
  ]
}
